{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 0,
  "modules-left": [],
  "modules-center": [
    "custom/notifications",
    "network",
    "battery",
    "clock",
    "custom/weather"
  ],
  "modules-right": [],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "󰤨 ",
    "format-ethernet": " ",
    "format-disconnected": "󰤭 ",
    "tooltip": false,
    "max-length": 50,
    "interval": 5
  },
  "battery": {
    "tooltip": false,
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'"
    },
    "format": "{icon}",
    "format-icons": [" ", " ", " ", " ", " "],
    "max-length": 25
  },
  "custom/notifications": {
    "format": " ",
    "on-click": "swaync-client -op",
    "tooltip": false
  },
  "custom/weather": {
    "format": "{} 󰅟 ",
    "tooltip": false,
    "interval": 1800,
    "exec": "cat ~/.cache/weather.txt"
  }
}
